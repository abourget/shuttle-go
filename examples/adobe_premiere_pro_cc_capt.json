{
    "apps": [
        {
            "name": "Adobe Premiere Pro CC (Capt)",
            "match_window_titles": [
                "Adobe Premiere Pro CC (Capt)",
                "Adobe Premiere Pro"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": {
                    "key": "R",
                    "comment": "Rewind"
                },
                "B1": {
                    "key": "G",
                    "comment": "Record"
                },
                "M1": {
                    "key": "I",
                    "comment": "Set In Point"
                },
                "M2": {
                    "key": "O",
                    "comment": "Set Out Point"
                },
                "F2": {
                    "key": "S",
                    "comment": "Stop"
                },
                "F3": {
                    "key": "F",
                    "comment": "Fast Forward"
                },
                "F4": {
                    "key": "T",
                    "comment": "Open the Capture Window"
                },
                "F5": {
                    "key": "Q",
                    "comment": "Go To In Point"
                },
                "F6": {
                    "key": "J",
                    "comment": "Reverse Play"
                },
                "F7": {
                    "key": "K",
                    "comment": "Pause/Stop"
                },
                "F8": {
                    "key": "L",
                    "comment": "Forward Play"
                },
                "F9": {
                    "key": "W",
                    "comment": "Go To Out Point"
                },
                "JogL": {
                    "key": "Shift+%",
                    "comment": "Reverse frame by frame"
                },
                "JogR": {
                    "key": "Shift+'",
                    "comment": "Forward frame by frame"
                },
                "S0": {
                    "key": "K",
                    "comment": "Pause"
                }
            }
        }
    ]
}
