{
    "apps": [
        {
            "name": "Audacity",
            "match_window_titles": [
                "Audacity"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": {
                    "key": "Ctrl+S",
                    "comment": "Save Project"
                },
                "B1": {
                    "key": "Shift+U",
                    "comment": "Mute"
                },
                "B2": {
                    "key": "Ctrl+1",
                    "comment": "Zoom in"
                },
                "B3": {
                    "key": "Shift+S",
                    "comment": "Solo"
                },
                "B4": {
                    "key": "Ctrl+3",
                    "comment": "Zoom out"
                },
                "M1": {
                    "key": "Ctrl+Y",
                    "comment": "Redo"
                },
                "M2": {
                    "key": "Ctrl+Z",
                    "comment": "Undo"
                },
                "F2": {
                    "key": "Ctrl+X",
                    "comment": "Cut"
                },
                "F3": {
                    "key": "Ctrl+C",
                    "comment": "Copy"
                },
                "F4": {
                    "key": "Ctrl+V",
                    "comment": "Paste"
                },
                "F5": {
                    "key": "Shift+$",
                    "comment": "Skipr to start"
                },
                "F7": {
                    "key": "space",
                    "comment": "Play/Stop"
                },
                "F9": {
                    "key": "Shift+#",
                    "comment": "Skip to end"
                },
                "JogL": {
                    "key": "Shift+%",
                    "comment": "Jog reverse"
                },
                "JogR": {
                    "key": "Shift+'",
                    "comment": "Jog forward"
                },
                "S-1": {
                    "key": "Shift+%",
                    "delay_ms": 500,
                    "comment": "Shuttle reverse"
                },
                "S-2": {
                    "key": "Shift+%",
                    "delay_ms": 200,
                    "comment": "Shuttle reverse"
                },
                "S-3": {
                    "key": "Shift+%",
                    "delay_ms": 100,
                    "comment": "Shuttle reverse"
                },
                "S-4": {
                    "key": "Shift+%",
                    "delay_ms": 67,
                    "comment": "Shuttle reverse"
                },
                "S-5": {
                    "key": "Shift+%",
                    "delay_ms": 33,
                    "comment": "Shuttle reverse"
                },
                "S-6": {
                    "key": "Shift+%",
                    "delay_ms": 22,
                    "comment": "Shuttle reverse"
                },
                "S-7": {
                    "key": "Shift+%",
                    "comment": "Shuttle reverse"
                },
                "S1": {
                    "key": "Shift+'",
                    "delay_ms": 500,
                    "comment": "Shuttle forward"
                },
                "S2": {
                    "key": "Shift+'",
                    "delay_ms": 200,
                    "comment": "Shuttle forward"
                },
                "S3": {
                    "key": "Shift+'",
                    "delay_ms": 100,
                    "comment": "Shuttle forward"
                },
                "S4": {
                    "key": "Shift+'",
                    "delay_ms": 67,
                    "comment": "Shuttle forward"
                },
                "S5": {
                    "key": "Shift+'",
                    "delay_ms": 33,
                    "comment": "Shuttle forward"
                },
                "S6": {
                    "key": "Shift+'",
                    "delay_ms": 22,
                    "comment": "Shuttle forward"
                },
                "S7": {
                    "key": "Shift+'",
                    "comment": "Shuttle forward"
                }
            }
        }
    ]
}
