                },
                "M1": {
                    "key": "Ctrl+Z",
                    "comment": "Undo"
                },
                "M2": {
                    "key": "Ctrl+Y",
                    "comment": "Redo"
                },
                "F2": {
                    "key": "Ctrl+S",
                    "comment": "Save File"
                },
                "F3": {
                    "key": "T",
                    "comment": "Record"
                },
                "F4": {
                    "key": "Shift+X",
