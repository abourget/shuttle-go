                    "comment": "New File"
                },
                "B1": {
                    "key": "Ctrl+Shift+P",
                    "comment": "Peak Finder"
                },
                "B2": {
                    "key": "Ctrl+T",
                    "comment": "Trim"
                },
                "B3": {
                    "key": "Ctrl+Shift+D",
                    "comment": "Split"
                },
                "B4": {
                    "key": "Ctrl+R",
